# Copy to .env.local and set the new self-hosted API URL and private admin key.
# `npx convex dev --once` writes CONVEX_URL and CONVEX_SITE_URL here afterward.
CONVEX_SELF_HOSTED_URL=
CONVEX_SELF_HOSTED_ADMIN_KEY=
# Client URLs live in each client: root VITE_CONVEX_URL, apps/expo EXPO_PUBLIC_CONVEX_URL.
# Backend secrets go in Convex deployment environment variables, never here.

# Set SITE_URL, RESEND_API_KEY and AUTH_EMAIL_FROM in the Convex deployment dashboard.
# Auth signing keys belong in the new Convex deployment environment, never this file.
# The legacy setup:auth:dev helper is restricted to the original cloud dev deployment.

# Phase 10: deployment-only EXPO_PROJECT_ID and NOTIFICATION_DELIVERY_ENABLED=true.
# Optional EXPO_PUSH_ACCESS_TOKEN is a dedicated push-service secret, never the EAS account token.
# Resend notifications also require verified AUTH_EMAIL_FROM and reachable HTTPS SITE_URL.
