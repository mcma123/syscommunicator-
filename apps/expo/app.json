{
  "expo": {
    "name": "WGJS Connect",
    "slug": "wynberg-girls-junior-connect",
    "version": "1.0.3",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/6cd3c02c-5a24-4596-84b0-7048bf2c7ea8"
    },
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "wgjsconnect",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#ffffff",
        "foregroundImage": "./assets/adaptive-icon.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "favicon": "./assets/logo.png",
      "name": "Wynberg Girls Junior Connect",
      "shortName": "WGJS Connect",
      "themeColor": "#c6252b",
      "backgroundColor": "#faf8f7"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#ffffff",
          "image": "./assets/logo.png",
          "imageWidth": 160
        }
      ],
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "defaultChannel": "school-updates",
          "color": "#c6252b"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "owner": "mcmarsh",
    "extra": {
      "router": {},
      "eas": {
        "projectId": "6cd3c02c-5a24-4596-84b0-7048bf2c7ea8"
      }
    }
  }
}
