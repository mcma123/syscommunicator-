# Expo account token: CLI only, never EXPO_PUBLIC_* or client config.
EXPO_TOKEN=
# Public Convex deployment URL for the web client (copy to .env.local). The web app
# uses this for authentication/identity; school-module data is still mocked. CONVEX_DEPLOYMENT belongs in packages/backend/.env.local, not here.
VITE_CONVEX_URL=
# Optional canonical web app origin for share images; defaults to the request origin.
# Example: https://connect.your-school-domain.co.za (not the school's public website).
VITE_SITE_URL=
